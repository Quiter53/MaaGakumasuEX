<UserControl x:Class="MFAAvalonia.Views.Pages.DrinkSettingsView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:MFAAvalonia.ViewModels.Pages" x:DataType="vm:DrinkSettingsViewModel" FontSize="14">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="DrinkFilterSurface" Color="#F1F3F9"/>
    <SolidColorBrush x:Key="DrinkAccentText" Color="#2454D7"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Dark">
    <SolidColorBrush x:Key="DrinkFilterSurface" Color="#24242B"/>
    <SolidColorBrush x:Key="DrinkAccentText" Color="#8AAEFF"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <UserControl.Styles>
  <Style Selector="Button.filter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style Selector="Button.filter.active"><Setter Property="Background" Value="{DynamicResource SukiCardBackground}"/><Setter Property="Foreground" Value="{DynamicResource DrinkAccentText}"/></Style>
 </UserControl.Styles>
 <Grid Margin="24" MaxWidth="1440">
  <Grid RowDefinitions="Auto,Auto,*" IsEnabled="{Binding !PickerOpen}">
   <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
    <StackPanel Spacing="8"><TextBlock Text="饮料策略" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="设置想要的饮料，以及每一种饮料的使用时机。" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="{DynamicResource SukiPrimaryColor5}" BorderBrush="{DynamicResource SukiPrimaryColor20}" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,20">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel Spacing="6"><TextBlock Text="最后一回合，使用全部剩余饮料" FontWeight="SemiBold"/><TextBlock Text="未触发指定条件的饮料也会使用，避免因漏识别而错过时机。" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="2" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
     <Grid ColumnDefinitions="Auto,*" Margin="20,16">
      <Border CornerRadius="9" Padding="4" Background="{DynamicResource DrinkFilterSurface}"><StackPanel Orientation="Horizontal" Spacing="2">
       <Button Classes="filter" Classes.active="{Binding AllSelected}" Content="{Binding AllLabel}" Tag="0" Click="FilterDrinks"/>
       <Button Classes="filter" Classes.active="{Binding TargetsSelected}" Content="{Binding TargetsLabel}" Tag="1" Click="FilterDrinks"/>
       <Button Classes="filter" Classes.active="{Binding OthersSelected}" Content="{Binding OthersLabel}" Tag="2" Click="FilterDrinks"/>
      </StackPanel></Border>
      <TextBox Grid.Column="1" Text="{Binding Search,Mode=TwoWay}" Watermark="搜索饮料名称或编号" Width="300" HorizontalAlignment="Right" Margin="20,0,0,0" AutomationProperties.Name="搜索饮料名称或编号"/>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource SukiPrimaryColor5}" Padding="20,12,32,12" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,1">
      <Grid ColumnDefinitions="3.2*,1.4*,2.3*,2.3*">
       <TextBlock Text="饮料" Foreground="{DynamicResource SukiLowText}"/>
       <TextBlock Grid.Column="1" Text="获取目标" Foreground="{DynamicResource SukiLowText}"/>
       <TextBlock Grid.Column="2" Text="使用时机" Foreground="{DynamicResource SukiLowText}"/>
       <TextBlock Grid.Column="3" Text="触发条件" Foreground="{DynamicResource SukiLowText}"/>
      </Grid>
     </Border>
     <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding VisibleDrinks}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DrinkRuleViewModel">
         <Border Padding="20,16" MinHeight="104" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SukiControlBorderBrush}">
          <Grid ColumnDefinitions="3.2*,1.4*,2.3*,2.3*">
           <Grid ColumnDefinitions="56,*" Margin="0,0,14,0" VerticalAlignment="Center">
            <Image Source="{Binding Thumbnail}" Width="52" Height="52" AutomationProperties.Name="{Binding Name}"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding JapaneseName}" FontSize="12" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/></StackPanel>
           </Grid>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <ToggleSwitch IsChecked="{Binding Target,Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" Width="52" MinWidth="0" RenderTransform="{x:Null}" AutomationProperties.Name="{Binding Name}"/>
            <TextBlock Text="{Binding TargetLabel}" FontSize="12" VerticalAlignment="Center"/>
           </StackPanel>
           <ComboBox Grid.Column="2" ItemsSource="{Binding TimingOptions}" SelectedIndex="{Binding Timing,Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,18,0" AutomationProperties.Name="使用时机"/>
           <Grid Grid.Column="3" VerticalAlignment="Center">
            <TextBlock Text="首回合出牌前使用" Foreground="{DynamicResource SukiLowText}" IsVisible="{Binding IsOpeningTiming}" TextWrapping="Wrap"/>
            <Button IsVisible="{Binding IsCardTiming}" Click="PickCard" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding CardLabel}"><TextBlock Text="{Binding CardLabel}" TextTrimming="CharacterEllipsis"/></Button>
            <WrapPanel IsVisible="{Binding IsTurnTiming}"><TextBlock Text="剩余 " VerticalAlignment="Center"/><NumericUpDown Value="{Binding Turns,Mode=TwoWay}" Minimum="1" Maximum="99" Increment="1" FormatString="0" Width="76" AutomationProperties.Name="剩余回合数"/><TextBlock Text=" 回合时使用" VerticalAlignment="Center"/></WrapPanel>
           </Grid>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock IsVisible="{Binding IsEmpty}" Text="没有匹配的饮料，请更换关键词或筛选条件。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SukiLowText}"/>
     </Grid>
     <TextBlock Grid.Row="3" Text="{Binding DrinkCount}" Margin="20,10" FontSize="12" Foreground="{DynamicResource SukiLowText}"/>
    </Grid>
   </Border>
  </Grid>
  <Border IsVisible="{Binding PickerOpen}" Background="{DynamicResource SukiCardBackground}" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" KeyDown="PickerKeyDown">
   <Grid RowDefinitions="Auto,Auto,Auto,* ,Auto">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PickerTitle}" FontSize="20" TextWrapping="Wrap"/><Button Grid.Column="1" Content="关闭" Click="ClosePicker" AutomationProperties.Name="关闭卡牌选择"/></Grid>
    <TextBox x:Name="CardSearchInput" Grid.Row="1" Text="{Binding CardSearch,Mode=TwoWay}" Watermark="搜索卡牌名称" Margin="0,12" AutomationProperties.Name="搜索触发卡牌"/>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
     <ComboBox ItemsSource="{Binding Rarities}" SelectedIndex="{Binding Rarity,Mode=TwoWay}" MinWidth="115" Margin="0,0,6,6" AutomationProperties.Name="稀有度"/>
     <ComboBox ItemsSource="{Binding Plans}" SelectedIndex="{Binding Plan,Mode=TwoWay}" MinWidth="105" Margin="0,0,6,6" AutomationProperties.Name="计划"/>
     <ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding Category,Mode=TwoWay}" MinWidth="105" Margin="0,0,6,6" AutomationProperties.Name="分类"/>
     <ComboBox ItemsSource="{Binding Origins}" SelectedIndex="{Binding Origin,Mode=TwoWay}" MinWidth="105" Margin="0,0,6,6" AutomationProperties.Name="来源"/>
     <ComboBox ItemsSource="{Binding Conversions}" SelectedIndex="{Binding Conversion,Mode=TwoWay}" MinWidth="105" Margin="0,0,6,6" AutomationProperties.Name="转换"/>
     <ComboBox ItemsSource="{Binding Levels}" SelectedIndex="{Binding Level,Mode=TwoWay}" MinWidth="105" Margin="0,0,6,6" AutomationProperties.Name="解锁等级"/>
    </WrapPanel>
    <ScrollViewer Grid.Row="3"><ItemsControl ItemsSource="{Binding VisibleCards}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CardListCard">
      <Button Width="134" Height="178" Margin="0,0,8,8" Padding="6" Click="ChooseCard" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
       <Border BorderBrush="{Binding RarityBrush}" BorderThickness="2" CornerRadius="8" Padding="5">
        <Grid RowDefinitions="100,Auto,*"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><TextBlock Grid.Row="1" Text="{Binding Rarity}" Foreground="{Binding RarityBrush}" FontSize="11"/><TextBlock Grid.Row="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="104"/></Grid>
       </Border>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></ScrollViewer>
    <TextBlock Grid.Row="4" Text="{Binding CardCount}" Margin="0,8,0,0"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
