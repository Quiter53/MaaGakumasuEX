<ResourceDictionary xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MFAAvalonia.Views.UserControls"
 xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
 xmlns:full="https://github.com/whistyun/Markdown.Avalonia"
 xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
 xmlns:extensions="clr-namespace:MFAAvalonia.Extensions">
 <ControlTheme x:Key="{x:Type controls:TooltipBlock}" TargetType="controls:TooltipBlock">
  <Setter Property="Template">
   <ControlTemplate>
    <Border Name="PART_Border" Width="16" Height="16" CornerRadius="8" Margin="3,0,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource LgAccentSoftBrush}">
     <Panel>
      <TextBlock Text="?" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LgAccentBrush}" />
      <Popup Name="PART_HelpPopup" Placement="Bottom" PlacementTarget="PART_Border" VerticalOffset="8"
             ShouldUseOverlayLayer="True" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
       <Border Padding="12" Background="Transparent">
        <lq:GlassPanel BlurRadius="20" CornerRadius="14" Padding="12,8" Background="{DynamicResource LgGlassElevatedBrush}"
                       MaxWidth="{Binding TooltipMaxWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="400">
         <full:MarkdownScrollViewer Markdown="{Binding TooltipText, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Top">
          <full:MarkdownScrollViewer.Engine><extensions:MarkdownExtension /></full:MarkdownScrollViewer.Engine>
          <full:MarkdownScrollViewer.Plugins><StaticResource ResourceKey="MdXamlPlugin" /></full:MarkdownScrollViewer.Plugins>
          <full:MarkdownScrollViewer.Styles>
           <StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlStyles.axaml" />
           <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock"><Setter Property="Margin" Value="0" /></Style>
          </full:MarkdownScrollViewer.Styles>
         </full:MarkdownScrollViewer>
        </lq:GlassPanel>
       </Border>
      </Popup>
     </Panel>
    </Border>
   </ControlTemplate>
  </Setter>
 </ControlTheme>
</ResourceDictionary>
