<UserControl
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.UserControls.Settings.GuiSettingsUserControl"
    x:DataType="settings:GuiSettingsUserControlModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="clr-namespace:MFAAvalonia.Helper.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:MFAAvalonia.Helper"
    xmlns:markup="https://codewf.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:other="clr-namespace:MFAAvalonia.ViewModels.Other"
    xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings"
    xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ContextMenu x:Key="ThemeColorContextMenu">
            <MenuItem Click="Delete" Classes="DangerContextDelete" Header="{markup:I18n {x:Static helper:LangKeys.Delete}}" />
        </ContextMenu>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.lg-swatch">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="14">
        <lq:GlassPanel Classes="box" Padding="18,4">
            <StackPanel>
                <lq:SettingRow Title="{lq:T 液态玻璃光学主题}" Description="{lq:T 浅色与深色主题，侧栏按钮同步切换}">
                    <lq:SegmentedControl SelectedIndex="{Binding BaseTheme, Converter={x:Static converters:ThemeVariantIndexConverter.Instance}, Mode=TwoWay}">
                        <TextBlock Text="{lq:T 冰川白昼（亮色）}" />
                        <TextBlock Text="{lq:T 深空暗夜（深色）}" />
                    </lq:SegmentedControl>
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{lq:T 强调色}" Description="{markup:I18n {x:Static helper:LangKeys.ConfigurePrimaryAccent}}" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsControl ItemsSource="{Binding ThemeItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="other:ThemeItemViewModel">
                                    <Button Classes="lg-swatch" Command="{Binding SelectThemeCommand}" ContextMenu="{StaticResource ThemeColorContextMenu}"
                                            ToolTip.Tip="{Binding Theme.DisplayName}" AutomationProperties.Name="{Binding Theme.DisplayName}">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="{Binding Theme.PrimaryBrush}" Width="26" Height="26" />
                                            <Ellipse Fill="{Binding Theme.AccentBrush}" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     Stroke="{DynamicResource LgGlassThumbBrush}" StrokeThickness="2" />
                                            <Border Width="16" Height="16" CornerRadius="99" Background="{DynamicResource LgAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0" IsVisible="{Binding IsSelected}">
                                                <PathIcon Data="{StaticResource LgCheckGeometry}" Width="9" Height="9" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="lg-sm" Command="{Binding CreateCustomThemeCommand}" VerticalAlignment="Center">
                            <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.CreateCustomTheme}}" />
                        </Button>
                    </StackPanel>
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{lq:T 背景弥散流体光晕}" Description="{lq:T 窗口背景的彩色光晕；关闭后保留纯色背景}">
                    <ToggleSwitch IsChecked="{Binding LiquidAmbient}" />
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{lq:T 减少动态效果}" Description="{lq:T 页面切换、弹窗、面板布局与背景动画直接完成}">
                    <ToggleSwitch IsChecked="{Binding ReduceMotion}" />
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{markup:I18n {x:Static helper:LangKeys.BackgroundImageTitle}}" Description="{markup:I18n {x:Static helper:LangKeys.BackgroundImageDescription}}">
                    <lq:SettingRow.Footer>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasBackgroundImage}">
                            <TextBlock Classes="lg-sub" VerticalAlignment="Center" Text="{markup:I18n {x:Static helper:LangKeys.BackgroundImageOpacityTitle}}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundImageOpacity}" />
                            <TextBlock Grid.Column="2" Classes="lg-sub" VerticalAlignment="Center" Width="44" TextAlignment="Right"
                                       Text="{Binding BackgroundImageOpacity, StringFormat='{}{0:P0}'}" />
                        </Grid>
                    </lq:SettingRow.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="lg-icon lg-sm" Command="{Binding ClearBackgroundImageCommand}" IsVisible="{Binding HasBackgroundImage}"
                                IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}" ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ButtonClear}}">
                            <lq:LiquidIcon Kind="trash" Size="13" />
                        </Button>
                        <Button Classes="lg-sm" Command="{Binding SelectBackgroundImageCommand}">
                            <TextBlock Text="{lq:T 选择图片}" />
                        </Button>
                    </StackPanel>
                </lq:SettingRow>
            </StackPanel>
        </lq:GlassPanel>

        <lq:GlassPanel Classes="box" Padding="18,4">
            <StackPanel>
                <lq:SettingRow Title="{markup:I18n {x:Static helper:LangKeys.LanguageOption}}" Description="{markup:I18n {x:Static helper:LangKeys.LanguageOptionDescription}}">
                    <ComboBox Width="200" DisplayMemberBinding="{Binding Name}" ItemsSource="{Binding SupportedLanguages}"
                              SelectedValue="{Binding CurrentLanguage}" SelectedValueBinding="{Binding Key}" />
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{markup:I18n {x:Static helper:LangKeys.FontScaleTitle}}" Description="{markup:I18n {x:Static helper:LangKeys.FontScaleDescription}}">
                    <lq:SettingRow.Footer>
                        <Slider Minimum="0.8" Maximum="1.5" Value="{Binding FontScale}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                    </lq:SettingRow.Footer>
                    <Border Classes="lg-badge"><TextBlock Text="{Binding FontScaleDisplay}" /></Border>
                </lq:SettingRow>
            </StackPanel>
        </lq:GlassPanel>

        <lq:GlassPanel Classes="box" Padding="18,4">
            <StackPanel>
                <lq:SettingRow Title="{markup:I18n {x:Static helper:LangKeys.MinimizeToTray}}" Description="{markup:I18n {x:Static helper:LangKeys.MinimizeToTrayDescription}}">
                    <ToggleSwitch IsChecked="{Binding ShouldMinimizeToTray}" />
                </lq:SettingRow>
                <Border Classes="lg-divider" />
                <lq:SettingRow Title="{markup:I18n {x:Static helper:LangKeys.Notification}}" Description="{markup:I18n {x:Static helper:LangKeys.NotificationDescription}}">
                    <ToggleSwitch IsChecked="{Binding EnableToastNotification}" />
                </lq:SettingRow>
            </StackPanel>
        </lq:GlassPanel>
    </StackPanel>
</UserControl>
