<UserControl x:Class="MFAAvalonia.Views.UserControls.Settings.VersionUpdateSettingsUserControl"
 x:DataType="settings:VersionUpdateSettingsUserControlModel"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:settings="clr-namespace:MFAAvalonia.ViewModels.UsersControls.Settings"
 xmlns:utilities="clr-namespace:MFAAvalonia.Utilities"
 xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid">
 <StackPanel Spacing="14">
  <lq:GlassPanel Classes="box" Padding="18,16">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
    <StackPanel Spacing="6">
     <TextBlock Text="MaaGakumasuEX" FontSize="17" FontWeight="SemiBold" />
     <TextBlock Classes="lg-sub" Text="{Binding ResourceVersion}" PointerPressed="CopyVersion" />
    </StackPanel>
    <Button Grid.Column="1" Classes="lg-sm" Content="{lq:T 打开发布页面}" VerticalAlignment="Center"
            Command="{x:Static utilities:UrlUtilities.OpenLink}" CommandParameter="https://github.com/Quiter53/MaaGakumasuEX/releases" />
   </Grid>
  </lq:GlassPanel>
  <lq:GlassPanel Classes="box" Padding="18,10">
   <StackPanel Spacing="6">
    <lq:SettingRow Title="{lq:T 启动时检查新版本}"><ToggleSwitch IsChecked="{Binding EnableCheckVersion}" /></lq:SettingRow>
    <lq:SettingRow Title="{lq:T 自动更新 MaaGakumasuEX}"><ToggleSwitch IsChecked="{Binding EnableAutoUpdateResource}" /></lq:SettingRow>
    <lq:SettingRow Title="{lq:T 更新渠道}">
     <ComboBox SelectedIndex="{Binding UpdateChannelIndex, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="更新渠道">
      <ComboBoxItem Content="{lq:T 稳定版}" />
      <ComboBoxItem Content="{lq:T 测试版}" />
     </ComboBox>
    </lq:SettingRow>
    <WrapPanel Orientation="Horizontal" Margin="0,8,0,2">
     <Button Classes="lg-primary lg-sm" Content="{lq:T 检查更新}" Margin="0,0,8,8" Command="{Binding CheckResourceUpdateCommand}" />
     <Button Classes="lg-sm" Content="{lq:T 更新完整包}" Margin="0,0,8,8" Command="{Binding UpdateResourceCommand}" />
     <Button Classes="lg-sm" Content="{lq:T 重新下载完整包}" Margin="0,0,0,8" Command="{Binding RedownloadResourceCommand}" />
    </WrapPanel>
   </StackPanel>
  </lq:GlassPanel>
  <lq:GlassPanel x:Name="DebugLocalPackageCard" Classes="box" Padding="18,14" IsVisible="{Binding ShowLocalPackageUpdate}">
   <Button Classes="lg-sm" Content="{lq:T 从本地完整包更新}" HorizontalAlignment="Left" Command="{Binding UpdateResourceFromLocalPackageCommand}" />
  </lq:GlassPanel>
 </StackPanel>
</UserControl>
