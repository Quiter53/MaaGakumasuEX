<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MFAAvalonia.Views.UserControls.TeachingTipOverlay"
             IsVisible="False" IsHitTestVisible="True">

    <Grid x:Name="OverlayRoot">
        <!-- Single dark overlay with cutout clip -->
        <Border x:Name="OverlayMask"
                Background="{DynamicResource LgModalScrimBrush}"
                IsHitTestVisible="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <!-- Canvas for positioned elements (arrow + tip), no background so clicks pass through empty areas -->
        <Canvas x:Name="OverlayCanvas"
                Width="{Binding #OverlayRoot.Bounds.Width}"
                Height="{Binding #OverlayRoot.Bounds.Height}">

            <!-- Teaching tip popup: same glass surface as dialogs (blurred backdrop + dropdown tint). -->
            <Border x:Name="TipBorder"
                    CornerRadius="18"
                    BoxShadow="{DynamicResource LgDropdownShadow}"
                    MaxWidth="360"
                    MinWidth="240"
                    IsHitTestVisible="True">
                <Panel>
                    <lq:BackdropBlur Radius="30" CornerRadius="18" />
                    <Border CornerRadius="18" Background="{DynamicResource LgGlassDropdownBrush}"
                            BorderBrush="{DynamicResource LgBorderOuterBrush}" BorderThickness="1" />
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20,16,20,16">
                        <Button x:Name="CloseButton"
                                Grid.Row="0"
                                Classes="lg-icon lg-sm"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-10,0"
                                AutomationProperties.Name="{lq:T 关闭}">
                            <lq:LiquidIcon Kind="x" Size="13" />
                        </Button>

                        <TextBlock x:Name="TipTitle"
                                   Grid.Row="0"
                                   Foreground="{DynamicResource LgTextMainBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,30,6" />

                        <TextBlock x:Name="TipDescription"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource LgTextSubBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   LineHeight="20" />

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button x:Name="PrevButton"
                                    Classes="lg-sm"
                                    IsVisible="False" />
                            <Button x:Name="NextButton"
                                    Classes="Flat lg-sm" />
                        </StackPanel>
                    </Grid>
                </Panel>
            </Border>

            <!-- Arrow polygon (after TipBorder for higher z-order) -->
            <Polygon x:Name="TipArrow"
                     Fill="{DynamicResource LgGlassDropdownBrush}"
                     IsVisible="False" />
        </Canvas>
    </Grid>
</UserControl>
