<UserControl
    x:Class="MFAAvalonia.Views.Mobile.RootViewContent"
    x:DataType="windows:RootViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:MFAAvalonia.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windows="clr-namespace:MFAAvalonia.ViewModels.Windows"
    xmlns:controls="clr-namespace:MFAAvalonia.Views.UserControls"
    xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
    xmlns:avaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    d:DesignHeight="1000"
    d:DesignWidth="1600"
    mc:Ignorable="d">
    <Design.DataContext>
        <windows:RootViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Sidebar navigation (prototype .nav-btn / .nav-active-pill) -->
        <Style Selector="Button.lg-nav">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource LgTextSubBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="0 0 0 0 #00000000" /></Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource LgTextMainBrush}" />
                <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="0 0 0 0 #00000000" /></Style>
                <Style Selector="^ /template/ Border#PART_Sheen"><Setter Property="Opacity" Value="0.65" /></Style>
            </Style>
            <Style Selector="^:pressed"><Setter Property="RenderTransform" Value="scale(0.96)" /></Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource LgTextMainBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style Selector="^ lq|LiquidIcon"><Setter Property="Foreground" Value="{DynamicResource LgAccentBrush}" /></Style>
            </Style>
            <Style Selector="^.collapsed">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="^.collapsed TextBlock.nav-label"><Setter Property="IsVisible" Value="False" /></Style>
        </Style>
        <Style Selector="Button.lg-nav.settings.active">
            <Setter Property="Background" Value="{DynamicResource LgGlassThumbBrush}" />
            <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="{DynamicResource LgThumbShadow}" /></Style>
        </Style>
        <Style Selector="Button.lg-theme-toggle">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource LgThemeButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LgTextMainBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style Selector="^ lq|LiquidIcon">
                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                <Setter Property="Transitions">
                    <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38" Easing="0.22,1,0.36,1" /></Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pointerover lq|LiquidIcon"><Setter Property="RenderTransform" Value="rotate(15deg) scale(1.08)" /></Style>
            <Style Selector="^:pressed"><Setter Property="RenderTransform" Value="scale(0.94)" /></Style>
            <Style Selector="^.collapsed">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="^.collapsed TextBlock.nav-label"><Setter Property="IsVisible" Value="False" /></Style>
        </Style>
        <Style Selector="Panel#TitleCenter">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="0.22,1,0.36,1" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="0.22,1,0.36,1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel#TitleCenter.hidden-bar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(-8px) scale(0.94)" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="lq|GlassPanel#SideBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="0.22,1,0.36,1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#NavPill">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38" Easing="0.22,1,0.36,1" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid>
        <LayoutTransformControl LayoutTransform="{Binding ScaleTransform, Source={x:Static helper:FontService.Instance}}">
            <Grid RowDefinitions="Auto,*" Margin="16">
                <!-- ============ Title bar ============ -->
                <lq:GlassPanel x:Name="TitleBar" Height="54" Padding="18,0,12,0" ClipContent="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" x:Name="TitleDragArea">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Width="28" Height="28" Stretch="Uniform" Source="{x:Static helper:IconHelper.Icon}" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                       Text="{Binding CustomTitle}" IsVisible="{Binding IsCustomTitleVisible}" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="MaaGakumasu"
                                       IsVisible="{Binding !IsCustomTitleVisible}" />
                            <Border Classes="lg-badge" BorderBrush="{DynamicResource LgBorderOuterBrush}" BorderThickness="1"
                                    IsVisible="{Binding ResourceVersion, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock x:Name="VersionBadgeText" Text="{Binding ResourceVersion}" />
                            </Border>
                            <Border Classes="lg-badge warning" IsVisible="{Binding IsDebugMode}">
                                <TextBlock Text="{lq:T 调试模式}" />
                            </Border>
                            <Button Classes="lg-link lg-sm" Command="{Binding TryUpdateCommand}" VerticalAlignment="Center"
                                    IsVisible="{Binding WindowUpdateInfo, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lq:LiquidIcon Kind="download" Size="13" />
                                    <TextBlock Text="{Binding WindowUpdateInfo}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Panel Grid.Column="1" x:Name="TitleCenter" VerticalAlignment="Center" Margin="16,0">
                            <controls:InstanceTabBar x:Name="TitleTabs" StripOnly="True" HorizontalAlignment="Center"
                                                     DataContext="{x:Static helper:Instances.InstanceTabBarViewModel}" />
                        </Panel>

                        <Border Grid.Column="2" Classes="lg-winctl-group" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="PinButton" Classes="lg-winctl" ToolTip.Tip="{lq:T 窗口置顶}">
                                    <lq:LiquidIcon Kind="pin" Size="13" />
                                </ToggleButton>
                                <Button x:Name="MinimizeButton" Classes="lg-winctl" ToolTip.Tip="{lq:T 最小化}">
                                    <lq:LiquidIcon Kind="winMin" Size="14" />
                                </Button>
                                <Button x:Name="MaximizeButton" Classes="lg-winctl" ToolTip.Tip="{lq:T 最大化 / 还原}">
                                    <lq:LiquidIcon x:Name="MaximizeIcon" Kind="winMax" Size="13" />
                                </Button>
                                <Button x:Name="CloseButton" Classes="lg-winctl close" ToolTip.Tip="{lq:T 关闭}">
                                    <lq:LiquidIcon Kind="winClose" Size="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </lq:GlassPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="Auto,*">
                    <!-- ============ Sidebar ============ -->
                    <lq:GlassPanel x:Name="SideBar" Width="186" Padding="10" ClipContent="True">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                                <Button x:Name="ThemeToggle" Classes="lg-theme-toggle">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <lq:LiquidIcon x:Name="ThemeIcon" Kind="sunAdaptive" Size="16" />
                                        <TextBlock x:Name="ThemeLabel" Classes="nav-label" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                                <Border Classes="lg-divider" />
                                <Button x:Name="SettingsNav" Classes="lg-nav settings" Tag="settings">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <lq:LiquidIcon Kind="settings" Size="16" />
                                        <TextBlock Classes="nav-label" Text="{lq:T 偏好设置}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Grid x:Name="SideHeader" ColumnDefinitions="*,Auto" Margin="4,2,4,6">
                                    <TextBlock x:Name="SideHeaderText" Text="{lq:T 导航菜单}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource LgTextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Button x:Name="SideToggle" Grid.Column="1" Classes="lg-icon" Width="30" Height="30">
                                        <lq:LiquidIcon Kind="sidebarLeft" Size="16" />
                                    </Button>
                                </Grid>
                                <Border Classes="lg-divider" Margin="0,-8,0,0" />
                                <Panel>
                                    <Border x:Name="NavPill" Height="40" CornerRadius="14" VerticalAlignment="Top"
                                            Background="{DynamicResource LgGlassThumbBrush}" BoxShadow="{DynamicResource LgThumbShadow}" IsHitTestVisible="False" />
                                    <StackPanel x:Name="NavList" Spacing="4" />
                                </Panel>
                            </StackPanel>
                        </DockPanel>
                    </lq:GlassPanel>

                    <!-- ============ Pages ============ -->
                    <Panel Grid.Column="1" x:Name="PageHost" Margin="14,0,0,0" />
                </Grid>
            </Grid>
        </LayoutTransformControl>

        <Border Background="{DynamicResource LgModalScrimBrush}" IsVisible="{Binding IsConfigSwitching}">
            <lq:GlassPanel Classes="elevated" Width="380" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="lg-title" Text="{lq:T 正在切换配置}" />
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ConfigSwitchProgress}" />
                </StackPanel>
            </lq:GlassPanel>
        </Border>

        <!-- First-use tutorial overlay -->
        <controls:TeachingTipOverlay x:Name="TutorialOverlay" />
    </Grid>
</UserControl>
