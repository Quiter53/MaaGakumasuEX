<?xml version="1.0" encoding="UTF-8"?>

<UserControl d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             x:Class="MFAAvalonia.Views.Pages.TaskQueueView"
             x:DataType="pages:TaskQueueViewModel"
             xmlns="https://github.com/avaloniaui"
             xmlns:binding="clr-namespace:MaaFramework.Binding;assembly=MaaFramework.Binding"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBindingAva"
             xmlns:converters="clr-namespace:MFAAvalonia.Helper.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ex="clr-namespace:SukiUI.Extensions;assembly=SukiUI"
             xmlns:valueType="clr-namespace:MFAAvalonia.Helper.ValueType"
             xmlns:maa="clr-namespace:MFAAvalonia.Extensions.MaaFW"
             xmlns:markup="https://codewf.com"
             xmlns:controls="clr-namespace:MFAAvalonia.Views.UserControls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:Avalonia.Xaml.Interactions.Core"
             xmlns:interaction="using:Avalonia.Xaml.Interactivity"
             xmlns:avalonia="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:helper="clr-namespace:MFAAvalonia.Helper"
             xmlns:avalonia1="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:other="clr-namespace:MFAAvalonia.ViewModels.Other"
             xmlns:dashboard="clr-namespace:MFAAvalonia.Views.UserControls.Dashboard"
             xmlns:extensions="clr-namespace:MFAAvalonia.Extensions"
             xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid">
    <Design.DataContext>
        <pages:TaskQueueViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <ContextMenu x:Key="TaskMenu"
                     Opening="TaskMenu_OnOpening">
            <MenuItem x:Name="TaskMenuRunSingle"
                      Click="RunSingleTask"
                      Header="{markup:I18n {x:Static helper:LangKeys.RunSingle}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon Icon="Play" IconSize="Size16" IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="TaskMenuRunCheckedFromCurrent"
                      Click="RunCheckedFromCurrent"
                      Header="{markup:I18n {x:Static helper:LangKeys.RunCheckedFromCurrent}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon Icon="ArrowRight" IconSize="Size16" IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="TaskMenuCopy"
                      Click="CopyTask"
                      InputGesture="Ctrl+C"
                      Header="{markup:I18n {x:Static helper:LangKeys.Copy}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="TaskMenuPaste"
                      Click="PasteTask"
                      InputGesture="Ctrl+V"
                      Header="{markup:I18n {x:Static helper:LangKeys.Paste}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon Icon="ClipboardPaste" IconSize="Size16" IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="TaskMenuRemark"
                      Click="EditTaskRemark"
                      Header="{markup:I18n {x:Static helper:LangKeys.TaskRemarkMenu}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon Icon="CommentEdit" IconSize="Size16" IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="TaskMenuDelete"
                      Click="Delete"
                      Classes="DangerContextDelete"
                      InputGesture="Delete"
                      Header="{markup:I18n {x:Static helper:LangKeys.Delete}}">
                <MenuItem.Icon>
                    <avalonia1:FluentIcon
                        Foreground="{DynamicResource SukiDangerColor}"
                        Icon="Delete"
                        IconSize="Size16"
                        IconVariant="Regular" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.SyncButton Path">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <RotateTransform Angle="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.SyncButton:pointerover Path">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1" />
                        <Setter Property="RotateTransform.Angle" Value="-15" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.SyncButton:not(:pointerover) Path">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.SyncButton:pressed Path">
            <Style.Animations>
                <Animation Duration="0:0:0.6" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>


        <!-- 中心绿点脉冲动画 -->
        <Style Selector="Ellipse#LiveStatusDot">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 外圈扩散动画 1 -->
        <Style Selector="Ellipse#PulseRing1">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
                        <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeThickness" Value="0.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 外圈扩散动画 2 (延迟 0.75s) -->
        <Style Selector="Ellipse#PulseRing2">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseOut" Delay="0:0:0.75">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
                        <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="StrokeThickness" Value="0.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>


        <!-- TaskToggle 外层悬停放大 -->
        <Style Selector="Border#TaskToggleBorder, Border#TaskToggleBorder1">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style Selector="Border#TaskToggleBorder:pointerover, Border#TaskToggleBorder1:pointerover">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
            </Setter>
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor75}" />
        </Style>

        <!-- 单层流光动画 -->
        <Style Selector="Border#TaskToggleShineLayer, Border#TaskToggleShineLayer1">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-160" />
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-160" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="160" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- BasicTight 悬停放大与前景变浅 -->
        <Style Selector="Button.TaskQueueBasicTight">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.TaskQueueBasicTight:pointerover">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor75}" />
        </Style>

        <Style Selector="Button.PlayStopButton:pointerover">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.PlayStopButton:not(:pointerover)">
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border#GradientButtonBorder:pointerover Border#ShineLayer1">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.25" />
                        <GradientStop Color="#40FFFFFF" Offset="0.45" />
                        <GradientStop Color="#70FFFFFF" Offset="0.5" />
                        <GradientStop Color="#40FFFFFF" Offset="0.55" />
                        <GradientStop Color="Transparent" Offset="0.75" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border#GradientButtonBorder:pointerover Border#ShineLayer2">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.25" />
                        <GradientStop Color="#40FFFFFF" Offset="0.45" />
                        <GradientStop Color="#70FFFFFF" Offset="0.5" />
                        <GradientStop Color="#40FFFFFF" Offset="0.55" />
                        <GradientStop Color="Transparent" Offset="0.75" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border#GradientButtonBorder:pointerover Border#ShineLayer3">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.25" />
                        <GradientStop Color="#40FFFFFF" Offset="0.45" />
                        <GradientStop Color="#70FFFFFF" Offset="0.5" />
                        <GradientStop Color="#40FFFFFF" Offset="0.55" />
                        <GradientStop Color="Transparent" Offset="0.75" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>


    <!-- 主布局：工具栏 + 可拖动面板工作台（布局模型见 Controls/Liquid/BoardLayout.cs） -->
    <Grid ClipToBounds="False" RowDefinitions="Auto,*" x:Name="MainGrid">
        <lq:GlassPanel Grid.Row="0" Padding="12,10,12,10" Margin="0,0,0,14" x:Name="ToolbarPanel">
            <Grid x:Name="TopToolbar" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="TopToolbarWide" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <lq:SegmentedControl x:Name="ResourceSelectorPanel"
                                         AutomationProperties.Name="{markup:I18n {x:Static helper:LangKeys.ResourceOption}}"
                                         ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ResourceOption}}"
                                         IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                                         ItemsSource="{Binding CurrentResources}"
                                         SelectedValueBinding="{Binding Name}"
                                         SelectedValue="{Binding CurrentResource, Mode=TwoWay}">
                        <lq:SegmentedControl.ItemTemplate>
                            <DataTemplate x:DataType="maa:MaaInterface+MaaInterfaceResource">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:DisplayIcon IconSource="{Binding ResolvedIcon}" IconSize="16" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" ToolTip.Tip="{Binding DisplayDescription}" />
                                </StackPanel>
                            </DataTemplate>
                        </lq:SegmentedControl.ItemTemplate>
                    </lq:SegmentedControl>
                    <lq:SegmentedControl x:Name="ControllerSelectorPanel"
                                         AutomationProperties.Name="{markup:I18n {x:Static helper:LangKeys.ControllerType}}"
                                         ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ControllerType}}"
                                         IsEnabled="{calcBinding:Binding '!LockController and Idle',Source={x:Static helper:Instances.RootViewModel}}"
                                         ItemsSource="{Binding ControllerOptions}"
                                         SelectedItem="{Binding SelectedController, Mode=TwoWay}">
                        <lq:SegmentedControl.ItemTemplate>
                            <DataTemplate x:DataType="maa:MaaInterface+MaaResourceController">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:DisplayIcon IconSource="{Binding ResolvedIcon}" IconSize="16" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" ToolTip.Tip="{Binding DisplayDescription}" />
                                </StackPanel>
                            </DataTemplate>
                        </lq:SegmentedControl.ItemTemplate>
                    </lq:SegmentedControl>
                    <Panel x:Name="DeviceSelectorPanel" MinWidth="200" MaxWidth="320"
                           IsVisible="{calcBinding:Binding 'CurrentController != maa:MaaControllerTypes.PlayCover'}">
                        <TextBlock x:Name="DeviceSelectorLabel" IsVisible="False" Text="{markup:I18n {x:Static helper:LangKeys.CurrentController}}" />
                        <ComboBox x:Name="DeviceComboBox"
                                  ex:ComboBoxExtensions.DisableNavigationOnLostFocus="True"
                                  AutomationProperties.Name="{markup:I18n {x:Static helper:LangKeys.CurrentController}}"
                                  IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                  ItemsSource="{Binding Devices}"
                                  PlaceholderText="{Binding CurrentDevicePlaceholderText}"
                                  HorizontalAlignment="Stretch"
                                  SelectedItem="{Binding CurrentDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding CurrentDeviceTooltipText}" />
                            </ToolTip.Tip>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={converters:DeviceDisplayConverter}}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={converters:DeviceDisplayConverter}, ConverterParameter=Dropdown}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Panel>
                </StackPanel>

                <StackPanel x:Name="ConnectionButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="lg-sm" Click="ToggleLiveView_OnClick" x:Name="LiveViewToggleButton"
                            ToolTip.Tip="{lq:T 显示或隐藏实时画面面板}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Panel>
                                <lq:LiquidIcon Kind="eye" Size="14" IsVisible="{Binding EnableLiveView}" />
                                <lq:LiquidIcon Kind="eyeOff" Size="14" IsVisible="{Binding !EnableLiveView}" />
                            </Panel>
                            <TextBlock Text="{lq:T 实时画面：开启}" IsVisible="{Binding EnableLiveView}" VerticalAlignment="Center" />
                            <TextBlock Text="{lq:T 实时画面：关闭}" IsVisible="{Binding !EnableLiveView}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="lg-sm" Click="ResetBoardLayout_OnClick" ToolTip.Tip="{lq:T 恢复默认布局：左侧任务列表与说明，中间任务设置，右侧日志}">
                        <TextBlock Text="{lq:T 恢复布局}" />
                    </Button>
                    <Button Classes="lg-sm" Click="ConnectionStatusButton_OnClick"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ConnectionSettings}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LgSuccessBrush}" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LgDangerBrush}" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
                            <TextBlock Text="{lq:T 设备已就绪}" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
                            <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.Unconnected}}" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="lg-icon lg-sm"
                            Command="{Binding CustomAdbCommand}"
                            IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                            IsVisible="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.Adb'}"
                            ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.Custom}}">
                        <lq:LiquidIcon Kind="edit" Size="14" />
                    </Button>
                    <Button Classes="lg-icon lg-sm"
                            Command="{Binding EditPlayCoverCommand}"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            IsVisible="{calcBinding:Binding 'CurrentController == maa:MaaControllerTypes.PlayCover'}"
                            ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.EditControllerConfiguration}}">
                        <lq:LiquidIcon Kind="edit" Size="14" />
                    </Button>
                    <Button Classes="lg-icon lg-sm"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.Reconnect}}">
                        <lq:LiquidIcon Kind="link" Size="14" />
                    </Button>
                    <Button Classes="lg-icon lg-sm SyncButton"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                            IsVisible="{calcBinding:Binding 'CurrentController != maa:MaaControllerTypes.PlayCover'}"
                            ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.TooltipRefresh}}">
                        <lq:LiquidIcon Kind="refresh" Size="14" />
                    </Button>
                    <Button x:Name="TaskToggleBorder" Classes="lg-primary" Height="38" MinWidth="120" Padding="18,0"
                            IsEnabled="{Binding ToggleEnable}" Command="{Binding ToggleCommand}">
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRunning}">
                                <lq:LiquidIcon Kind="play" Size="13" />
                                <TextBlock Text="{lq:T 开始运行}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRunning}">
                                <lq:LiquidIcon Kind="stop" Size="13" />
                                <TextBlock Text="{lq:T 停止运行}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </lq:GlassPanel>

        <ScrollViewer Grid.Row="1" x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <lq:LiquidBoard x:Name="TaskQueueBoard">
                <!-- 任务列表 -->
                <lq:BoardPanel x:Name="TaskListCard" PanelId="task_list" Title="{markup:I18n {x:Static helper:LangKeys.TaskList}}">
                    <lq:BoardPanel.HeaderActions>
                        <StackPanel x:Name="TaskListHeaderButtons" Orientation="Horizontal" Spacing="6">
                            <Button Classes="lg-sm" Command="{Binding SelectAllCommand}"
                                    IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.SelectAll}}">
                                <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.SelectAll}}" />
                            </Button>
                            <Button Classes="lg-icon lg-sm" Command="{Binding SelectNoneCommand}"
                                    IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.DeselectAll}}">
                                <lq:LiquidIcon Kind="minus" Size="13" />
                            </Button>
                            <Button Classes="lg-icon lg-sm" Command="{Binding AddTaskCommand}"
                                    IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.AddTask}}">
                                <lq:LiquidIcon Kind="plus" Size="13" Foreground="{DynamicResource LgAccentBrush}" />
                            </Button>
                            <Button Classes="lg-icon lg-sm SyncButton" Command="{Binding ResetTasksCommand}"
                                    IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.Reset}}">
                                <lq:LiquidIcon Kind="refresh" Size="13" />
                            </Button>
                        </StackPanel>
                    </lq:BoardPanel.HeaderActions>
                    <ListBox Classes="lg-task-list"
                             DragDrop.AllowDrop="{Binding Idle,Source={x:Static helper:Instances.RootViewModel}}"
                             extensions:DragDropExtensions.EnableDragDrop="True"
                             extensions:DragDropExtensions.DragStartThreshold="2"
                             extensions:DragDropExtensions.EnableAnimation="True"
                             ItemsSource="{Binding Path=TaskItemViewModels}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                             KeyDown="TaskListBox_OnKeyDown"
                             x:Name="TaskListBox">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Panel>
                                    <Border BorderBrush="{DynamicResource LgDangerBrush}" BorderThickness="1.5" CornerRadius="16"
                                            IsVisible="{Binding HasValidationError}" IsHitTestVisible="False" />
                                    <Grid ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.TooltipDragLabel}}"
                                          Background="Transparent"
                                          extensions:DragDropExtensions.LimitDragDrop="True"
                                          ColumnDefinitions="Auto,*,Auto,Auto"
                                          ContextMenu="{StaticResource TaskMenu}"
                                          PointerPressed="TaskItem_OnPointerPressed"
                                          ContextRequested="TaskItem_OnContextRequested"
                                          MinHeight="44"
                                          x:Name="ListGrid">
                                        <lq:LiquidIcon Kind="grip" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource LgTextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="0">
                                            <controls:DisplayIcon IconSource="{Binding ResolvedIcon}" IconSize="18" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <lq:LiquidIcon Grid.Column="2" Kind="settings2" Size="14" Margin="6,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource LgAccentBrush}" IsVisible="{Binding EnableSetting}" />
                                        <CheckBox Grid.Column="3" Classes="Switch lg-task-switch" IsThreeState="True"
                                                  extensions:CheckBoxExtensions.EnableRightClickNull="{Binding !IsResourceOptionItem}"
                                                  extensions:CheckBoxExtensions.LimitDragDrop="True"
                                                  IsEnabled="{Binding !IsResourceOptionItem}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCheckedWithNull}" />
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </lq:BoardPanel>

                <!-- 任务说明 -->
                <lq:BoardPanel x:Name="IntroductionCard" PanelId="task_desc" Title="{markup:I18n {x:Static helper:LangKeys.TaskDescription}}">
                    <mdxaml:MarkdownScrollViewer Focusable="True" x:Name="Introduction">
                        <mdxaml:MarkdownScrollViewer.Engine>
                            <extensions:MarkdownExtension />
                        </mdxaml:MarkdownScrollViewer.Engine>
                        <mdxaml:MarkdownScrollViewer.Styles>
                            <StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlDocStyle.axaml" />
                        </mdxaml:MarkdownScrollViewer.Styles>
                        <mdxaml:MarkdownScrollViewer.Plugins>
                            <StaticResource ResourceKey="MdXamlPlugin" />
                        </mdxaml:MarkdownScrollViewer.Plugins>
                    </mdxaml:MarkdownScrollViewer>
                </lq:BoardPanel>

                <!-- 任务设置 -->
                <lq:BoardPanel x:Name="SettingCard" PanelId="task_settings" Title="{markup:I18n {x:Static helper:LangKeys.TaskSettings}}">
                    <lq:BoardPanel.HeaderActions>
                        <Border x:Name="SettingsHeaderButtons" IsVisible="{Binding ShowSettings}" CornerRadius="999" Padding="3"
                                Background="{DynamicResource LgGlassTrackBrush}" BorderBrush="{DynamicResource LgBorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton FontSize="12" Classes="Inner" IsChecked="{Binding IsCommon}" GroupName="SettingA">
                                    <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.CommonSetting}}" />
                                </RadioButton>
                                <RadioButton FontSize="12" Classes="Inner" GroupName="SettingA" IsChecked="{calcBinding:Binding '!IsCommon'}">
                                    <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.AdvancedSetting}}" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </lq:BoardPanel.HeaderActions>
                    <ScrollViewer x:Name="SettingsContent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,6,0">
                            <StackPanel IsVisible="{calcBinding:Binding 'IsCommon'}" x:Name="CommonOptionSettings" Orientation="Vertical" Classes="lg-options" />
                            <StackPanel IsVisible="{calcBinding:Binding '!IsCommon'}" x:Name="AdvancedOptionSettings" Orientation="Vertical" Classes="lg-options" />
                        </Grid>
                    </ScrollViewer>
                </lq:BoardPanel>

                <!-- 运行日志 -->
                <lq:BoardPanel x:Name="LogCard" PanelId="log" Title="{markup:I18n {x:Static helper:LangKeys.LogRecord}}">
                    <lq:BoardPanel.HeaderActions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="lg-badge neutral">
                                <TextBlock Text="{Binding LogItemViewModels.Count, StringFormat='{}{0}'}" />
                            </Border>
                            <Button Classes="lg-sm" Command="{Binding ExportCommand}"
                                    IsEnabled="{Binding CurrentInstanceIdle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ExportLog}}">
                                <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.ExportLog}}" />
                            </Button>
                            <Button Classes="lg-icon lg-sm SyncButton" Command="{Binding ClearCommand}"
                                    IsEnabled="{Binding Idle, Source={x:Static helper:Instances.RootViewModel}}"
                                    ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ButtonClear}}">
                                <lq:LiquidIcon Kind="trash" Size="13" />
                            </Button>
                        </StackPanel>
                    </lq:BoardPanel.HeaderActions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  extensions:ScrollViewerExtensions.AutoScroll="True"
                                  extensions:ScrollViewerExtensions.PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Path=LogItemViewModels}" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="lg-log-item">
                                        <Grid Name="ParentGrid" ColumnDefinitions="Auto,*">
                                            <Grid.Resources>
                                                <suki:IfConditionConverter x:Key="IfConditionConverter">
                                                    <suki:IfConditionConverter.False>
                                                        <DataTemplate DataType="other:LogItemViewModel">
                                                            <TextBlock FontSize="12.5"
                                                                       FontWeight="{Binding Weight}"
                                                                       Foreground="{Binding Color}"
                                                                       Background="{Binding BackgroundColor}"
                                                                       TextWrapping="WrapWithOverflow"
                                                                       Text="{Binding Content}" />
                                                        </DataTemplate>
                                                    </suki:IfConditionConverter.False>
                                                    <suki:IfConditionConverter.True>
                                                        <DataTemplate DataType="other:LogItemViewModel">
                                                            <mdxaml:MarkdownScrollViewer Markdown="{Binding Content}">
                                                                <mdxaml:MarkdownScrollViewer.Engine>
                                                                    <extensions:MarkdownExtension />
                                                                </mdxaml:MarkdownScrollViewer.Engine>
                                                                <mdxaml:MarkdownScrollViewer.Styles>
                                                                    <StyleInclude Source="avares://MFAAvalonia.Core/Assets/Style/MdXamlDocStyle.axaml" />
                                                                </mdxaml:MarkdownScrollViewer.Styles>
                                                                <mdxaml:MarkdownScrollViewer.Plugins>
                                                                    <StaticResource ResourceKey="MdXamlPlugin" />
                                                                </mdxaml:MarkdownScrollViewer.Plugins>
                                                            </mdxaml:MarkdownScrollViewer>
                                                        </DataTemplate>
                                                    </suki:IfConditionConverter.True>
                                                </suki:IfConditionConverter>
                                            </Grid.Resources>
                                            <TextBlock FontSize="11.5" Name="FirstCol" Foreground="{DynamicResource LgTextMutedBrush}"
                                                       IsVisible="{Binding ShowTime}" Margin="0,1,10,0" MinWidth="52" Text="{Binding Time}" VerticalAlignment="Top" />
                                            <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Top"
                                                            ContentTemplate="{Binding UseMarkdown,Converter={StaticResource IfConditionConverter}}">
                                                <ContentControl.MaxWidth>
                                                    <MultiBinding Converter="{converters:MaxWidthConverter}">
                                                        <Binding ElementName="ParentGrid" Path="Bounds.Width" />
                                                        <Binding ElementName="FirstCol" Path="Bounds.Width" />
                                                    </MultiBinding>
                                                </ContentControl.MaxWidth>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </lq:BoardPanel>

                <!-- 实时画面（默认关闭） -->
                <lq:BoardPanel x:Name="LiveViewCard" PanelId="live_view" Title="{markup:I18n {x:Static helper:LangKeys.LiveView}}">
                    <Border x:Name="LiveViewFrame" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource LgGlassTrackBrush}">
                        <Grid>
                            <StackPanel IsVisible="{Binding LiveViewImage, Converter={x:Static ObjectConverters.IsNull}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <lq:LiquidIcon Kind="image" Size="28" Foreground="{DynamicResource LgTextMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.ScreenshotPlaceholder}}" Classes="lg-sub" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Image Source="{Binding LiveViewImage}" IsVisible="{Binding LiveViewImage, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="Uniform" />
                            <Grid IsHitTestVisible="False" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" Margin="8">
                                <Border Classes="lg-chip" HorizontalAlignment="Left">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:BooleanAndConverter.Instance}">
                                            <Binding Path="IsRunning" />
                                            <Binding Path="LiveViewImage" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                                            <Ellipse x:Name="PulseRing1" Width="8" Height="8" Stroke="{DynamicResource LgSuccessBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="50%,50%">
                                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="PulseRing2" Width="8" Height="8" Stroke="{DynamicResource LgSuccessBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="50%,50%">
                                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="LiveStatusDot" Width="8" Height="8" Fill="{DynamicResource LgSuccessBrush}" RenderTransformOrigin="50%,50%">
                                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.Running}}" FontSize="11" Foreground="{DynamicResource LgSuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="lg-chip" HorizontalAlignment="Right">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:BooleanAndConverter.Instance}">
                                            <Binding Path="CurrentTaskName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                            <Binding Path="LiveViewImage" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.Task}}" FontSize="11" />
                                        <TextBlock Text=": " FontSize="11" />
                                        <TextBlock Text="{Binding CurrentTaskName}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Classes="lg-chip" HorizontalAlignment="Left"
                                        IsVisible="{Binding LiveViewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock FontSize="11" Text="{Binding LiveViewFps, StringFormat='FPS: {0:F1}'}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </lq:BoardPanel>
            </lq:LiquidBoard>
        </ScrollViewer>
        <TextBlock x:Name="BoardAnnouncement" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
