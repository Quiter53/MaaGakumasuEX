<UserControl xmlns:ex="clr-namespace:MFAAvalonia.Helper" xmlns:markup="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia" x:Class="MFAAvalonia.Views.Pages.DrinkSettingsView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
             xmlns:vm="clr-namespace:MFAAvalonia.ViewModels.Pages" x:DataType="vm:DrinkSettingsViewModel">
    <UserControl.Resources>
        <ex:ExLabelConverter x:Key="ExLabel" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <!-- 顶部：标题、目标筛选、自动保存状态、搜索 -->
        <lq:GlassPanel Padding="18,10" CornerRadius="20">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                <TextBlock Text="{markup:I18n Ex7325ed4b24fd}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                <lq:SegmentedControl Grid.Column="1" x:Name="FilterSegment" SelectedIndex="{Binding TargetFilter, Mode=TwoWay}"
                                     AutomationProperties.Name="{lq:T 饮料筛选}">
                    <TextBlock Text="{Binding AllLabel, Converter={StaticResource ExLabel}}" />
                    <TextBlock Text="{Binding TargetsLabel, Converter={StaticResource ExLabel}}" />
                    <TextBlock Text="{Binding OthersLabel, Converter={StaticResource ExLabel}}" />
                </lq:SegmentedControl>
                <TextBlock Grid.Column="2" Classes="lg-sub" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                           Text="{Binding Status, Converter={StaticResource ExLabel}}" ToolTip.Tip="{markup:I18n Ex362ec700afec}" />
                <TextBox Grid.Column="3" Width="260" Text="{Binding Search, Mode=TwoWay}" Watermark="{markup:I18n Ex1630ba8d2b75}"
                         AutomationProperties.Name="{markup:I18n Ex1630ba8d2b75}" />
            </Grid>
        </lq:GlassPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel Spacing="10">
                <TextBlock Classes="lg-sub" Text="{Binding DrinkCount, Converter={StaticResource ExLabel}}" Margin="4,0,0,0" />
                <TextBlock Classes="lg-sub" IsVisible="{Binding IsEmpty}" Text="{lq:T 没有匹配的饮料}" HorizontalAlignment="Center" Margin="0,40" />
                <ItemsControl ItemsSource="{Binding VisibleDrinks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <lq:RowGridPanel Columns="2" Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DrinkRuleViewModel">
                            <lq:GlassPanel Padding="18,14" CornerRadius="22">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource LgGlassElevatedBrush}"
                                                BorderBrush="{DynamicResource LgBorderOuterBrush}" BorderThickness="1" BoxShadow="{DynamicResource LgThumbShadow}">
                                            <Image Source="{Binding Thumbnail}" Width="30" Height="30" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource ExLabel}}" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding JapaneseName}" FontSize="11.5" Classes="lg-sub" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="160" IsVisible="{Binding !IsRuleTiming}" ItemsSource="{Binding TimingOptions}"
                                                  ItemTemplate="{x:Static ex:ExText.ItemTemplate}" SelectedIndex="{Binding Timing, Mode=TwoWay}"
                                                  AutomationProperties.Name="{lq:T 使用时机}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="lg-link lg-sm" IsVisible="{Binding IsRuleTiming}" Click="OpenRules" VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding RuleHint, Converter={StaticResource ExLabel}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{lq:T 跟随出牌规则}" VerticalAlignment="Center" />
                                                <lq:LiquidIcon Kind="externalLink" Size="12" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding Target, Mode=TwoWay}" VerticalAlignment="Center"
                                                      ToolTip.Tip="{lq:T 目标饮料：培育中优先获取}" AutomationProperties.Name="{lq:T 目标饮料}" />
                                    </Grid>
                                    <!-- 指定卡牌前使用 -->
                                    <lq:GlassPanel Classes="box" Padding="12,8" IsVisible="{Binding IsCardTiming}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{lq:T 打出此卡前饮用：}" Classes="lg-sub" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CardLabel, Converter={StaticResource ExLabel}}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Classes="lg-sm" Click="PickCard" Content="{lq:T 选择卡牌}" />
                                        </Grid>
                                    </lq:GlassPanel>
                                    <!-- 倒数 N 回合使用 -->
                                    <lq:GlassPanel Classes="box" Padding="12,8" IsVisible="{Binding IsTurnTiming}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{lq:T 饮用时机：剩余回合}" Classes="lg-sub" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Width="120" Minimum="1" Maximum="99" Increment="1" FormatString="0"
                                                           Value="{Binding Turns, Mode=TwoWay}" AutomationProperties.Name="{lq:T 倒数回合}" />
                                        </Grid>
                                    </lq:GlassPanel>
                                </StackPanel>
                            </lq:GlassPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
