<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
             xmlns:helper="clr-namespace:MFAAvalonia.Helper"
             xmlns:markup="https://codewf.com"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBindingAva"
             xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Name="RootMonitorView"
             x:Class="MFAAvalonia.Views.Pages.MonitorView"
             x:DataType="pages:MonitorViewModel">
    <UserControl.Styles>
        <Style Selector="Ellipse.RunningPulse">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <!-- 顶部：标题、排序、缩放、新增配置 -->
        <lq:GlassPanel Padding="18,8" CornerRadius="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{lq:T 多开实例监控矩阵}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <lq:LiquidIcon Kind="arrowDown" Size="14" Foreground="{DynamicResource LgTextSubBrush}" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{Binding SortIndex}" Width="150" AutomationProperties.Name="{lq:T 排序}">
                        <ComboBoxItem Content="{markup:I18n {x:Static helper:LangKeys.MonitorSortDefault}}" />
                        <ComboBoxItem Content="{markup:I18n {x:Static helper:LangKeys.MonitorSortByStatus}}" />
                        <ComboBoxItem Content="{markup:I18n {x:Static helper:LangKeys.MonitorSortByName}}" />
                        <ComboBoxItem Content="{markup:I18n {x:Static helper:LangKeys.MonitorSortByCreatedTime}}" />
                    </ComboBox>
                    <Border Classes="lg-vdivider" Height="18" Margin="2,0" />
                    <Button Classes="lg-icon lg-sm" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ZoomOut}}"
                            AutomationProperties.Name="{markup:I18n {x:Static helper:LangKeys.ZoomOut}}">
                        <lq:LiquidIcon Kind="minus" Size="12" />
                    </Button>
                    <TextBlock Text="{Binding CardScaleText}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                    <Button Classes="lg-icon lg-sm" Command="{Binding ZoomInCommand}" ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.ZoomIn}}"
                            AutomationProperties.Name="{markup:I18n {x:Static helper:LangKeys.ZoomIn}}">
                        <lq:LiquidIcon Kind="plus" Size="12" />
                    </Button>
                    <Button Classes="lg-primary lg-sm" Command="{Binding AddInstanceCommand, Source={x:Static helper:Instances.InstanceTabBarViewModel}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lq:LiquidIcon Kind="plus" Size="12" />
                            <TextBlock Text="{lq:T 新增配置}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </lq:GlassPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:MonitorItemViewModel">
                        <lq:GlassPanel Classes="interactive" Width="{Binding CardWidth}" Height="{Binding CardHeight}" Padding="14"
                                       ClipContent="True" PointerPressed="OnCardPointerPressed" AutomationProperties.Name="{Binding Name}">
                            <lq:GlassPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.StartTask}}" Command="{Binding StartTaskCommand}"
                                              IsVisible="{calcBinding:Binding 'IsConnected and !IsRunning'}" />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.StopTask}}" Command="{Binding StopTaskCommand}"
                                              IsVisible="{calcBinding:Binding 'IsConnected and IsRunning'}" />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.MonitorForceRefresh}}" Command="{Binding ConnectCommand}" IsEnabled="{Binding IsConnected}" />
                                    <Separator />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.MonitorFullScreen}}" Command="{Binding FullScreenCommand}" IsEnabled="{Binding HasImage}" />
                                    <Separator />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.SaveScreenshot}}" Command="{Binding SaveScreenshotCommand}" IsEnabled="{Binding HasImage}" />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.MonitorCopyScreenshot}}" Command="{Binding CopyScreenshotCommand}" IsEnabled="{Binding HasImage}" />
                                    <Separator />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.MonitorDisconnect}}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
                                    <MenuItem Header="{markup:I18n {x:Static helper:LangKeys.MonitorTryConnect}}" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" />
                                </ContextMenu>
                            </lq:GlassPanel.ContextMenu>
                            <Grid RowDefinitions="*,Auto" RowSpacing="12">
                                <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource LgGlassCardBrush}"
                                        BorderBrush="{DynamicResource LgBorderSubtleBrush}" BorderThickness="1">
                                    <Panel>
                                        <Image Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding HasImage}" />
                                        <lq:LiquidIcon Kind="image" Size="34" Foreground="{DynamicResource LgTextMutedBrush}" IsVisible="{Binding !HasImage}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Classes="lg-badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" IsVisible="{Binding IsRunning}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource LgAccentBrush}" Classes="RunningPulse" VerticalAlignment="Center" />
                                                <TextBlock Text="{markup:I18n {x:Static helper:LangKeys.MonitorLiveBadge}}" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LgSuccessBrush}" IsVisible="{Binding IsRunning}" Classes="RunningPulse" VerticalAlignment="Center" />
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LgSuccessBrush}" IsVisible="{calcBinding:Binding '!IsRunning and IsConnected'}" VerticalAlignment="Center" />
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource LgDangerBrush}" IsVisible="{calcBinding:Binding '!IsRunning and !IsConnected'}" VerticalAlignment="Center" />
                                            <TextBlock Classes="lg-sub" Text="{markup:I18n {x:Static helper:LangKeys.Running}}" IsVisible="{Binding IsRunning}" />
                                            <TextBlock Classes="lg-sub" Text="{markup:I18n {x:Static helper:LangKeys.Connected}}" IsVisible="{calcBinding:Binding '!IsRunning and IsConnected'}" />
                                            <TextBlock Classes="lg-sub" Text="{markup:I18n {x:Static helper:LangKeys.Unconnected}}" IsVisible="{calcBinding:Binding '!IsRunning and !IsConnected'}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="lg-primary lg-sm" Command="{Binding StartTaskCommand}" IsVisible="{Binding !IsRunning}"
                                            IsEnabled="{Binding IsConnected}" Content="{lq:T 启动}" ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.StartTask}}" />
                                    <Button Grid.Column="1" Classes="lg-sm lg-danger-text" Command="{Binding StopTaskCommand}" IsVisible="{Binding IsRunning}"
                                            Content="{lq:T 停止}" ToolTip.Tip="{markup:I18n {x:Static helper:LangKeys.StopTask}}" />
                                </Grid>
                            </Grid>
                        </lq:GlassPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
