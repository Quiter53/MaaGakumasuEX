<UserControl
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.SettingsView"
    x:DataType="pages:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:lq="clr-namespace:MFAAvalonia.Controls.Liquid"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Button.lg-section">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource LgTextSubBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="0 0 0 0 #00000000" /></Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource LgTextMainBrush}" />
                <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="0 0 0 0 #00000000" /></Style>
            </Style>
            <Style Selector="^.active">
                <Setter Property="Background" Value="{DynamicResource LgGlassThumbBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LgTextMainBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style Selector="^ /template/ Border#PART_Bg"><Setter Property="BoxShadow" Value="{DynamicResource LgThumbShadow}" /></Style>
            </Style>
        </Style>
        <Style Selector="Border.section-dot">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BoxShadow" Value="inset 0 1.5 1 0 #A6FFFFFF, inset 0 -1 1 0 #26000000, 0 3 8 -1 #29000000" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="240,14,*">
        <lq:GlassPanel Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{lq:T 系统偏好设置}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource LgTextMutedBrush}" Margin="10,4,0,10" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsLayout" Spacing="4" />
                </ScrollViewer>
            </DockPanel>
        </lq:GlassPanel>
        <lq:GlassPanel Grid.Column="2" Padding="26,22,26,22" ClipContent="True">
            <DockPanel>
                <lq:GlassPanel DockPanel.Dock="Top" Classes="box" Padding="18,14" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border x:Name="SectionColor" Classes="section-dot" Width="34" Height="34" CornerRadius="10" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SectionTitle" FontSize="17" FontWeight="Bold" />
                            <TextBlock x:Name="SectionDesc" Classes="lg-sub" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="lg-badge success" VerticalAlignment="Center">
                            <TextBlock Text="{lq:T 实时自动保存}" />
                        </Border>
                    </Grid>
                </lq:GlassPanel>
                <ScrollViewer x:Name="Settings" HorizontalScrollBarVisibility="Disabled">
                    <Panel x:Name="SectionHost" Margin="0,0,6,6" />
                </ScrollViewer>
            </DockPanel>
        </lq:GlassPanel>
    </Grid>
</UserControl>
